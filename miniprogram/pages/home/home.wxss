.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
}

/* 顶部 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: #fff;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.role-badge {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #fff;
}

.role-badge.counselor { background: #e91e63; }
.role-badge.admin { background: #ff9800; }
.role-badge.student { background: #4caf50; }

.logout {
  color: #666;
  font-size: 28rpx;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.card-title {
  padding: 24rpx;
  font-size: 30rpx;
  font-weight: bold;
  border-bottom: 1rpx solid #eee;
  background: #fafafa;
}

.card-content {
  padding: 24rpx;
}

/* 输入框 */
.input {
  width: 100%;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 10rpx;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

/* 按钮 */
.btn-primary {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 10rpx;
  font-size: 30rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-success {
  width: 100%;
  height: 80rpx;
  background: #4caf50;
  color: #fff;
  border-radius: 10rpx;
  font-size: 28rpx;
}

.btn-danger {
  width: 100%;
  height: 80rpx;
  background: #f44336;
  color: #fff;
  border-radius: 10rpx;
  font-size: 28rpx;
  margin-top: 20rpx;
}

/* 位置开关 */
.location-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  color: #666;
}

/* 状态项 */
.status-item {
  display: flex;
  padding: 12rpx 0;
  font-size: 28rpx;
}

.status-item .label {
  color: #666;
  width: 160rpx;
}

.status-item .value {
  color: #333;
}

.status-item .value.success { color: #4caf50; }
.status-item .value.warning { color: #ff9800; }

/* 账号列表 */
.account-list {
  font-size: 26rpx;
}

.account-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.account-item.header {
  font-weight: bold;
  color: #666;
  background: #f9f9f9;
  padding: 16rpx;
  border-radius: 8rpx;
}

.account-item > text:first-child { flex: 1; }
.account-item > text:nth-child(2) { flex: 1; }
.account-item > text:nth-child(3) { flex: 1; }

.account-scroll {
  max-height: 400rpx;
}

.role-tag {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #fff;
}

.role-tag.counselor { background: #e91e63; }
.role-tag.admin { background: #ff9800; }
.role-tag.student { background: #4caf50; }

.actions {
  display: flex;
  gap: 16rpx;
}

.action-edit { color: #2196f3; }
.action-delete { color: #f44336; }

/* 签到名单 */
.attendance-list {
  font-size: 26rpx;
}

.attendance-item {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.attendance-item.header {
  font-weight: bold;
  color: #666;
  background: #f9f9f9;
  padding: 16rpx;
  border-radius: 8rpx;
}

.attendance-item > text { flex: 1; }
.attendance-item > text:nth-child(3) { flex: 0.8; }

.attendance-scroll {
  max-height: 300rpx;
}

.empty {
  text-align: center;
  color: #999;
  padding: 40rpx;
}

/* 弹窗 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30rpx;
}

.modal-input {
  width: 100%;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 10rpx;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.modal-role {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  font-size: 28rpx;
}

.picker {
  flex: 1;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 10rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  margin-left: 20rpx;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
}

.modal-actions button {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
}

.modal-actions .btn-primary {
  margin-top: 0;
}

/* 班级列表 */
.class-list {
  margin-bottom: 20rpx;
}

.class-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 10rpx;
  margin-bottom: 16rpx;
}

.class-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.class-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.class-stats {
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
}

.class-delete {
  color: #f44336;
  font-size: 26rpx;
  padding: 10rpx;
}
